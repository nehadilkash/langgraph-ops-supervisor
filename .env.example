LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# GitHub Issues: fine-grained token needs Issues read/write access.
GITHUB_REPOSITORY=nehadilkash/langgraph-ops-supervisor
GITHUB_TOKEN=
# Optional comma-separated HTTP(S) health endpoints.
HEALTHCHECK_URLS=https://httpbin.org/status/503

# Optional Microsoft Teams Workflows incoming webhook URL.
TEAMS_WEBHOOK_URL=

# Optional LangSmith API key for the Studio UI.
LANGSMITH_API_KEY=

# To use OpenAI instead, set LLM_PROVIDER=openai and configure:
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-4o-mini
